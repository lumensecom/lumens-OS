# Copia este archivo a .env.local y completa los valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integraciones (opcionales hasta activarlas)
OPENROUTER_API_KEY=           # openrouter.ai → Keys (activa /api/ai · una key da todos los modelos gratis: Nemotron, Gemma 4, código)
DROPI_WEBHOOK_SECRET=         # secreto compartido para /api/webhooks/dropi
DAPTA_FLOW_WEBHOOK_URL=       # URL del flujo de Dapta (get_flow_webhook_url) — activa /llamadas
DAPTA_WEBHOOK_SECRET=         # opcional: header compartido si el flujo lo valida
DAPTA_RESULT_SECRET=          # requerido para Llamadas: valida /api/webhooks/dapta

# Shopify · recepción de pedidos para la torre
SHOPIFY_STORE_DOMAIN=        # dominio permanente de la tienda (formato tienda.myshopify.com)
SHOPIFY_WEBHOOK_SECRET=      # secreto que firma orders/create

# Juliana · flujo de confirmación por WhatsApp, separado de Llamadas IA
DAPTA_WHATSAPP_WEBHOOK_URL=
DAPTA_WHATSAPP_WEBHOOK_SECRET=
DAPTA_WHATSAPP_RESULT_SECRET=
