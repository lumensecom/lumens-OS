# Copia este archivo a .env.local y completa los valores.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Integraciones (opcionales hasta activarlas)
NVIDIA_API_KEY=               # build.nvidia.com → "Get API Key" (activa /api/ai · modelos gratis: Nemotron, DeepSeek V4, Gemma 4)
DROPI_WEBHOOK_SECRET=         # secreto compartido para /api/webhooks/dropi
DAPTA_FLOW_WEBHOOK_URL=       # URL del flujo de Dapta (get_flow_webhook_url) — activa /llamadas
DAPTA_WEBHOOK_SECRET=         # opcional: header compartido si el flujo lo valida
DAPTA_RESULT_SECRET=          # opcional: valida el post-call webhook en /api/webhooks/dapta
