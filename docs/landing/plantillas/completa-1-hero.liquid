  .lmn-seal-top, .lmn-seal-bot { font-size: 7.5px; }
}
</style>

<script>
(function () {
  function init() {
    // 1. CARRUSEL + MINIATURAS + SWIPE TÁCTIL
    var track = document.getElementById('lmnSliderTrack');
    var slides = document.querySelectorAll('.lmn-slide');
    var prevBtn = document.getElementById('lmnPrevBtn');
    var nextBtn = document.getElementById('lmnNextBtn');
    var thumbs = document.querySelectorAll('.lmn-thumb');
    var currentIndex = 0;
    var totalSlides = slides.length;

    if (track && totalSlides > 1) {
      var goToSlide = function (index) {
        if (index < 0) index = totalSlides - 1;
        if (index >= totalSlides) index = 0;
        currentIndex = index;
        track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
        thumbs.forEach(function (t, idx) { t.classList.toggle('is-active', idx === currentIndex); });
        var act = thumbs[currentIndex];
        if (act && act.parentNode) { act.parentNode.scrollLeft = act.offsetLeft - 40; }
      };
      if (prevBtn) prevBtn.addEventListener('click', function () { goToSlide(currentIndex - 1); });
      if (nextBtn) nextBtn.addEventListener('click', function () { goToSlide(currentIndex + 1); });
      thumbs.forEach(function (t) {
        t.addEventListener('click', function () { goToSlide(parseInt(t.getAttribute('data-index'), 10)); });
      });

      var x0 = null;
      track.addEventListener('touchstart', function (ev) { x0 = ev.touches[0].clientX; }, { passive: true });
      track.addEventListener('touchend', function (ev) {
        if (x0 === null) return;
        var dx = ev.changedTouches[0].clientX - x0;
        if (Math.abs(dx) > 40) goToSlide(dx < 0 ? currentIndex + 1 : currentIndex - 1);
        x0 = null;
      }, { passive: true });
    }

    // 2. FECHAS DINÁMICAS DE ENTREGA (SOLO DÍAS HÁBILES)
    var MES = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
    function habil(d, k) {
      d = new Date(d);
      while (k > 0) {
        d.setDate(d.getDate() + 1);
        var w = d.getDay();
        if (w !== 0 && w !== 6) k--;
      }
      return d;
    }
    function f(d) { return d.getDate() + ' ' + MES[d.getMonth()]; }
    function rango(x, y) { return x.getMonth() === y.getMonth() ? x.getDate() + ' - ' + f(y) : f(x) + ' - ' + f(y); }

    var tl = document.getElementById('lmnTimeline');
    if (tl) {
      var hoy = new Date(), dd = tl.dataset;
      var q = function (s) { return tl.querySelector('[data-f="' + s + '"]'); };
      if (q('hoy')) q('hoy').textContent = 'Hoy, ' + f(hoy);
      if (q('desp')) q('desp').textContent = rango(habil(hoy, +dd.d1), habil(hoy, +dd.d2));
      if (q('entr')) q('entr').textContent = rango(habil(hoy, +dd.e1), habil(hoy, +dd.e2));
    }

    // 3. BUNDLES + SINCRONIZACIÓN CON RELEASIT COD FORM
    var form = document.getElementById('product-form-lmn');
    var qtyInput = document.getElementById('lmn-qty');
    var bundleOptions = document.querySelectorAll('.lmn-bundle-option');
    var selectedIndex = '0';

    // Marca en Releasit la oferta de la misma posición (0 = 1, 1 = 2, 2 = 3 chalecos).
    function clickOferta() {
      var todas = document.querySelectorAll('._rsi-quantity-offers-offer-container[data-offer-pos="' + selectedIndex + '"]');
      if (!todas.length) return false;
      var visibles = [].filter.call(todas, function (o) { return o.offsetParent !== null; });
      (visibles.length ? visibles : [].slice.call(todas)).forEach(function (o) { o.click(); });
      return true;
    }

    // Espera a que Releasit pinte sus ofertas y la vuelve a marcar.
    function marcarOfertaReleasit(intentos) {
      intentos = intentos || 0;
      if (clickOferta()) {
        setTimeout(clickOferta, 400);
        setTimeout(clickOferta, 1000);
        return;
      }
      if (intentos < 50) {
        setTimeout(function () { marcarOfertaReleasit(intentos + 1); }, 100);
      }
    }

    bundleOptions.forEach(function (option) {
      option.addEventListener('click', function () {
        bundleOptions.forEach(function (opt) { opt.classList.remove('is-selected'); });
        option.classList.add('is-selected');
        var radio = option.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;

        selectedIndex = option.getAttribute('data-bundle-index') || '0';
        if (qtyInput) {
          qtyInput.value = option.getAttribute('data-qty') || '1';
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        var ya = document.querySelector('._rsi-quantity-offers-offer-container[data-offer-pos="' + selectedIndex + '"]');
        if (ya) ya.click();
      });
    });

    // 3B. TALLA Y COLOR → actualiza la variante del formulario (Releasit la toma al abrir)
    var vbox = document.getElementById('lmnVariants');
    var vdata = document.getElementById('lmnVariantData');
    if (vbox && vdata) {
      var variantes = [];
      try { variantes = JSON.parse(vdata.textContent); } catch (err) {}
      var grupos = vbox.querySelectorAll('.lmn-vgroup');
      var elegidos = [].map.call(grupos, function (g) {
        var on = g.querySelector('.lmn-vchip.is-on');
        return on ? on.getAttribute('data-val') : null;
      });
      var aplicarVariante = function () {
        var v = variantes.filter(function (x) {
          return elegidos.every(function (val, i) { return val === null || x.o[i] === val; });
        })[0];
        if (!v) return;
        document.querySelectorAll('#product-form-lmn [name="id"], form[action*="/cart/add"] [name="id"]').forEach(function (inp) {
          inp.value = v.id;
          inp.dispatchEvent(new Event('change', { bubbles: true }));
        });
        try {
          var u = new URL(window.location.href);
          u.searchParams.set('variant', v.id);
          window.history.replaceState({}, '', u.toString());
        } catch (err) {}
        // Marca como agotadas las combinaciones sin stock
        grupos.forEach(function (g, gi) {
          g.querySelectorAll('.lmn-vchip').forEach(function (c) {
            var prueba = elegidos.slice(); prueba[gi] = c.getAttribute('data-val');
            var hay = variantes.some(function (x) { return x.ok && prueba.every(function (val, i) { return val === null || x.o[i] === val; }); });
            c.classList.toggle('is-off', !hay);
          });
        });
      };
      grupos.forEach(function (g, gi) {
        g.querySelectorAll('.lmn-vchip').forEach(function (c) {
          c.addEventListener('click', function () {
            if (c.classList.contains('is-off')) return;
            g.querySelectorAll('.lmn-vchip').forEach(function (x) { x.classList.remove('is-on'); });
            c.classList.add('is-on');
            elegidos[gi] = c.getAttribute('data-val');
            var lab = g.querySelector('.lmn-vval'); if (lab) lab.textContent = elegidos[gi];
            aplicarVariante();
          });
        });
      });
      aplicarVariante();
    }

    // 4. DISPARO DE BOTÓN PRINCIPAL Y STICKY
    var fastBuyBtn = document.getElementById('lmn-fast-buy-btn');
    var stickyTriggerBtn = document.getElementById('lmnStickyTriggerBtn');
    var abriendo = false;

    function botonReleasit() {
      return (form && form.querySelector('._rsi-buy-now-button-product, ._rsi-buy-now-button, #_rsi-buy-now-button')) ||
             document.querySelector('._rsi-buy-now-button-product, ._rsi-buy-now-button, #_rsi-buy-now-button');
    }

    function triggerCheckout(e) {
      if (e) e.preventDefault();
      if (abriendo) return;
      abriendo = true;
      var btn = e && e.currentTarget;
      if (btn) btn.classList.add('is-loading');

      var intentos = 0;
      (function intentar() {
        var rsi = botonReleasit();
        if (rsi) {
          clickOferta();
          rsi.click();
          marcarOfertaReleasit(0);
          terminar();
        } else if (intentos < 30) {
          intentos++;
          setTimeout(intentar, 100);
        } else {
          terminar();
          var aviso = document.getElementById('lmnAviso');
          if (aviso) aviso.style.display = 'block';
        }
      })();

      function terminar() {
        setTimeout(function () {
          abriendo = false;
          if (btn) btn.classList.remove('is-loading');
        }, 600);
      }
    }

    if (fastBuyBtn) fastBuyBtn.addEventListener('click', triggerCheckout);
    if (stickyTriggerBtn) stickyTriggerBtn.addEventListener('click', triggerCheckout);

    // 5. BARRA FIJA: aparece solo cuando ya pasaste el botón principal
    var stickyBar = document.getElementById('lmnStickyBar');
    var checkoutArea = document.getElementById('lmnCheckoutFormTarget');
    if (stickyBar && checkoutArea && 'IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          var pasado = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          stickyBar.classList.toggle('is-visible', pasado);
        });
      }, { threshold: 0 });
      observer.observe(checkoutArea);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
