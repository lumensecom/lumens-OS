<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet">

{%- comment -%}
  CHALECO MOLDEADOR · HERO
  PRECIOS · Se escriben siempre como $99.900, sin importar el formato de moneda de la tienda.
  1 chaleco = precio del producto en Shopify. Si no tiene "Precio de comparación", se usa $159.900.
  2 y 3 chalecos se fijan aquí abajo (en centavos: 14990000 = $149.900).

  GUÍA DE TALLAS · Copia las medidas de la ficha del proveedor en Dropi, una talla por línea:
     Talla|Peso|Contorno de abdomen
  Si la dejas vacía, la guía solo dice que te confirmamos la talla por WhatsApp.
{%- endcomment -%}
{%- assign lmn_p2 = 14990000 -%}
{%- assign lmn_p3 = 18990000 -%}
{%- capture lmn_tallas -%}
{%- endcapture -%}
{%- assign lmn_tabla = lmn_tallas | strip | newline_to_br | split: '<br />' -%}

{%- assign lmn_p1 = product.price -%}
{%- assign lmn_antes = product.compare_at_price | default: 0 -%}
{%- if lmn_antes <= lmn_p1 -%}{%- assign lmn_antes = 15990000 -%}{%- endif -%}
{%- assign lmn_a2 = lmn_p1 | times: 2 -%}
{%- assign lmn_a3 = lmn_p1 | times: 3 -%}
{%- assign lmn_ah1 = lmn_antes | minus: lmn_p1 -%}
{%- assign lmn_pct = lmn_ah1 | times: 100 | divided_by: lmn_antes -%}
{%- assign lmn_ah2 = lmn_p1 | times: 2 | minus: lmn_p2 -%}
{%- assign lmn_ah3 = lmn_p1 | times: 3 | minus: lmn_p3 -%}
{%- assign lmn_u2 = lmn_p2 | divided_by: 2 -%}
{%- assign lmn_u3 = lmn_p3 | divided_by: 3 -%}
{%- assign lmn_lista = lmn_p1 | append: ',' | append: lmn_antes | append: ',' | append: lmn_p2 | append: ',' | append: lmn_a2 | append: ',' | append: lmn_p3 | append: ',' | append: lmn_a3 | append: ',' | append: lmn_ah1 | append: ',' | append: lmn_ah2 | append: ',' | append: lmn_ah3 | append: ',' | append: lmn_u2 | append: ',' | append: lmn_u3 | split: ',' -%}
{%- capture lmn_fmt -%}
  {%- for v in lmn_lista -%}
    {%- assign n = v | plus: 0 | divided_by: 100 -%}
    {%- assign mil = n | divided_by: 1000 -%}
    {%- assign r = n | modulo: 1000 -%}
    {%- if mil > 0 -%}
      {%- if r < 10 -%}{%- assign rr = r | prepend: '00' -%}{%- elsif r < 100 -%}{%- assign rr = r | prepend: '0' -%}{%- else -%}{%- assign rr = r -%}{%- endif -%}
      ${{ mil }}.{{ rr }}
    {%- else -%}${{ r }}{%- endif -%}
    {%- unless forloop.last -%}|{%- endunless -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign M = lmn_fmt | strip | split: '|' -%}

<!-- BARRA DE ANUNCIOS -->
<div class="lmn-announcement-bar" role="region" aria-label="Beneficios LUMENS">
  <div class="lmn-announcement-track">
    {%- for i in (1..2) -%}
    <div class="lmn-announcement-group"{% if i == 2 %} aria-hidden="true"{% endif %}>
      <span>🚚 <strong>ENVÍO GRATIS</strong> a toda Colombia</span>
      <span class="lmn-ann-sep">•</span>
      <span>💵 <strong>PAGO CONTRA ENTREGA</strong> · Pagas al recibir</span>
      <span class="lmn-ann-sep">•</span>
      <span>🔄 <strong>CAMBIO DE TALLA</strong> en 30 días</span>
      <span class="lmn-ann-sep">•</span>
      <span>📦 <strong>EMPAQUE DISCRETO</strong></span>
      <span class="lmn-ann-sep">•</span>
    </div>
    {%- endfor -%}
  </div>
</div>

<div class="lmn-product-container">

  <!-- GALERÍA -->
  <div class="lmn-gallery-col">
    <div class="lmn-main-image-card">
      <div class="lmn-seal" aria-hidden="true">
        <span class="lmn-seal-top">CAMBIO DE</span>
        <span class="lmn-seal-big">TALLA</span>
        <span class="lmn-seal-bot">30 DÍAS</span>
      </div>
      <div class="lmn-slider-viewport">
        <div class="lmn-slider-track" id="lmnSliderTrack">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: 8 %}
              <div class="lmn-slide {% if forloop.first %}is-active{% endif %}">
                <img
                  src="{{ media | image_url: width: 1000 }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="1000"
                  height="1000"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  {% if forloop.first %}fetchpriority="high"{% endif %}
                >
              </div>
            {% endfor %}
          {% else %}
            <div class="lmn-slide is-active">
              {{ 'product-1' | placeholder_svg_tag: 'lmn-placeholder-img' }}
            </div>
          {% endif %}
        </div>
      </div>

      {% if product.media.size > 1 %}
        <button type="button" class="lmn-arrow-btn lmn-arrow-prev" id="lmnPrevBtn" aria-label="Anterior">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button type="button" class="lmn-arrow-btn lmn-arrow-next" id="lmnNextBtn" aria-label="Siguiente">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {% endif %}
    </div>

    {% if product.media.size > 1 %}
      <div class="lmn-thumbs" id="lmnThumbs">
        {% for media in product.media limit: 8 %}
          <button type="button" class="lmn-thumb {% if forloop.first %}is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Imagen {{ forloop.index }}">
            <img src="{{ media | image_url: width: 160 }}" alt="" width="80" height="80" loading="lazy">
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <!-- TEXTO Y COMPRA -->
  <div class="lmn-copy-col">

    <div class="lmn-top-bar">
      <span class="lmn-trust-mini"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Pagas al recibir</span>
      <span class="lmn-trust-mini"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg> Te confirmamos la talla por WhatsApp</span>
    </div>

    <div class="lmn-header-group">
      <h1 class="lmn-heading">
        Chaleco Moldeador | Ponte la camisa que quieras y
        <span class="lmn-underline-container">
          sal sin revisarte
          <svg class="lmn-curved-underline" viewBox="0 0 100 10" preserveAspectRatio="none"><path d="M0 8 C 30 2, 70 2, 100 8" stroke="#0E2A47" stroke-width="3" fill="transparent" stroke-linecap="round"/></svg>
        </span>
      </h1>
      <p class="lmn-sub">Compresión firme que aplana abdomen y pecho debajo de tu ropa, desde que te lo pones.</p>
    </div>

    <!-- 4 BENEFICIOS CON ÍCONO -->
    <div class="lmn-benefits">
      <div class="lmn-benefit">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 6c-3 6-4 12-2 18s2 12-1 18"/><path d="M32 6c3 6 4 12 2 18s-2 12 1 18"/><path d="M19 24h10"/><path d="M26 21l3 3-3 3"/><path d="M22 21l-3 3 3 3"/></svg>
        <span>Disimula la barriga</span>
      </div>
      <div class="lmn-benefit">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 8c2 4 6 6 14 6s12-2 14-6"/><path d="M12 14c-1 6 1 10 6 11"/><path d="M36 14c1 6-1 10-6 11"/><path d="M18 25c2 2 10 2 12 0"/><path d="M24 30v10"/><path d="M20 36l4 4 4-4"/></svg>
        <span>Aplana el pecho</span>
      </div>
      <div class="lmn-benefit">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="24" cy="8" r="4"/><path d="M24 12v20"/><path d="M16 18h16"/><path d="M24 32l-6 10"/><path d="M24 32l6 10"/><path d="M38 8v28"/><path d="M35 11l3-3 3 3"/></svg>
        <span>Te para más derecho</span>
      </div>
      <div class="lmn-benefit">
        <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 6l-9 5 3 9 4-2v22h18V18l4 2 3-9-9-5"/><path d="M17 6c1 3 4 5 7 5s6-2 7-5"/><path d="M24 11v29"/></svg>
        <span>No se nota bajo la ropa</span>
      </div>
    </div>

    <!-- GUÍA DE TALLAS -->
    <details class="lmn-size">
      <summary>
        <span>Guía de tallas</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="10" rx="2"/><path d="M6 7v3M10 7v4M14 7v3M18 7v4"/></svg>
      </summary>
      <div class="lmn-size-body">
        {%- assign lmn_hay_tallas = false -%}
        {%- for fila in lmn_tabla -%}{%- assign c = fila | strip | split: '|' -%}{%- if c.size >= 2 -%}{%- assign lmn_hay_tallas = true -%}{%- endif -%}{%- endfor -%}
        {%- if lmn_hay_tallas -%}
          <table>
            <thead><tr><th>Talla</th><th>Peso</th><th>Abdomen</th></tr></thead>
            <tbody>
              {%- for fila in lmn_tabla -%}
                {%- assign c = fila | strip | split: '|' -%}
                {%- if c.size >= 2 -%}<tr><td><b>{{ c[0] | strip }}</b></td><td>{{ c[1] | strip }}</td><td>{{ c[2] | strip }}</td></tr>{%- endif -%}
              {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}
        <p>Tallas <b>S, M, L, XL, 2XL y 3XL</b>. Elige la tuya arriba y, después de tu pedido, te escribimos por WhatsApp con tu peso y estatura para confirmarla <b>antes de enviarlo</b>. Si estás entre dos tallas, pide la más grande. Y si no te queda, te la cambiamos.</p>
      </div>
    </details>

    <!-- TALLA Y COLOR (cambia la variante que se envía a Releasit) -->
    {%- if product.has_only_default_variant == false -%}
    <div class="lmn-variants" id="lmnVariants">
      {%- assign lmn_sel = product.selected_or_first_available_variant -%}
      {%- for option in product.options_with_values -%}
        {%- assign lmn_on = option.name | downcase -%}
        <div class="lmn-vgroup" data-pos="{{ forloop.index0 }}">
          <p class="lmn-vlabel">{% if lmn_on contains 'tall' or lmn_on contains 'size' %}Elige tu talla{% elsif lmn_on contains 'col' %}Elige tu color{% else %}{{ option.name }}{% endif %}: <b class="lmn-vval">{{ lmn_sel.options[forloop.index0] }}</b></p>
          <div class="lmn-vchips">
            {%- for value in option.values -%}
              <button type="button" class="lmn-vchip{% if value == lmn_sel.options[forloop.parentloop.index0] %} is-on{% endif %}" data-val="{{ value | escape }}">{% if lmn_on contains 'col' %}{{ value | capitalize }}{% else %}{{ value }}{% endif %}</button>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
      <script type="application/json" id="lmnVariantData">[{%- for v in product.variants -%}{"id":{{ v.id }},"o":{{ v.options | json }},"ok":{{ v.available | json }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]</script>
    </div>
    {%- endif -%}

    <div class="lmn-offer-divider"><span>ELIGE TU PACK · PAGAS AL RECIBIR</span></div>

    <div class="lmn-checkout-wrapper">
      <form method="post" action="/cart/add" id="product-form-lmn" accept-charset="UTF-8" class="form" enctype="multipart/form-data">
        <input type="hidden" name="form_type" value="product">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="id" id="lmn-variant-id" value="{{ product.selected_or_first_available_variant.id }}">
        <input type="hidden" name="quantity" id="lmn-qty" value="1">

        <div class="lmn-bundle-section">

          <!-- OPCIÓN 1 -->
          <label class="lmn-bundle-option is-selected" data-bundle-index="0" data-qty="1">
            <div class="lmn-radio-custom"></div>
            <input type="radio" name="bundle" value="1" checked>
            <div class="lmn-bundle-content">
              <div class="lmn-bundle-info">
                <span class="lmn-bundle-name">1 chaleco</span>
                <span class="lmn-bundle-shipping">{{ lmn_pct }}% OFF · Para probarlo</span>
              </div>
              <div class="lmn-bundle-price">
                <span class="lmn-price-current">{{ M[0] }}</span>
                <span class="lmn-price-old">{{ M[1] }}</span>
              </div>
            </div>
          </label>

          <!-- OPCIÓN 2 -->
          <label class="lmn-bundle-option is-popular" data-bundle-index="1" data-qty="2">
            <div class="lmn-popular-tag">🔥 MÁS PEDIDO</div>
            <div class="lmn-radio-custom"></div>
            <input type="radio" name="bundle" value="2">
            <div class="lmn-bundle-content">
              <div class="lmn-bundle-info">
                <span class="lmn-bundle-name">2 chalecos</span>
                <span class="lmn-bundle-shipping">{{ M[9] }} c/u · uno de cambio</span>
              </div>
              <div class="lmn-bundle-price">
                <span class="lmn-price-current">{{ M[2] }}</span>
                <span class="lmn-price-old">{{ M[3] }}</span>
              </div>
            </div>
          </label>

          <!-- OPCIÓN 3 -->
          <label class="lmn-bundle-option is-best" data-bundle-index="2" data-qty="3">
            <div class="lmn-best-tag">💎 MEJOR PRECIO</div>
            <div class="lmn-radio-custom"></div>
            <input type="radio" name="bundle" value="3">
            <div class="lmn-bundle-content">
              <div class="lmn-bundle-info">
                <span class="lmn-bundle-name">3 chalecos</span>
                <span class="lmn-bundle-shipping">{{ M[10] }} c/u · los 3 colores</span>
              </div>
              <div class="lmn-bundle-price">
                <span class="lmn-price-current">{{ M[4] }}</span>
                <span class="lmn-price-old">{{ M[5] }}</span>
              </div>
            </div>
          </label>
          <p class="lmn-bundle-note">Si pides 2 o 3 y los quieres de tallas o colores distintos, nos lo dices por WhatsApp al confirmar tu pedido.</p>
        </div>

        <div class="realeasit-btn-wrapper" id="lmnCheckoutFormTarget">
          <button type="button" class="lmn-main-action-btn lmn-super-cta" id="lmn-fast-buy-btn">
            <div class="lmn-main-btn-inner-border">
              <span class="lmn-main-btn-text">¡PEDIR Y PAGAR AL RECIBIR!</span>
            </div>
          </button>
        </div>

        <p class="lmn-aviso" id="lmnAviso">Esta talla o color no está disponible ahora. Elige otra o <a href="https://wa.me/573125923915?text=Hola!%20Quiero%20pedir%20el%20Chaleco%20Moldeador" target="_blank" rel="noopener">pídelo por WhatsApp</a>.</p>

        <div class="lmn-trust-icons-row">
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg> Pago contra entrega</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg> Envío gratis</span>
          <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg> Cambio de talla</span>
        </div>
      </form>
    </div>

    <div class="lmn-feature-pills">
      <div class="lmn-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> 3 niveles de ganchos</div>
      <div class="lmn-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Cremallera frontal</div>
      <div class="lmn-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Negro, blanco, beige</div>
      <div class="lmn-pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg> Tallas S a 3XL</div>
    </div>

    <div class="lmn-guarantee-box">
      <div class="lmn-guarantee-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 3 4.5 6v6c0 4.5 3.2 7.8 7.5 9 4.3-1.2 7.5-4.5 7.5-9V6z"/><path d="m8.8 12 2.2 2.2 4.4-4.4"/></svg>
      </div>
      <div class="lmn-guarantee-text">
        <strong>Si no te queda, te lo cambiamos.</strong> Tienes 30 días para cambiar la talla o si llega con algún defecto.
      </div>
    </div>

    <div class="lmn-shipping-timeline-card" id="lmnTimeline" data-d1="1" data-d2="2" data-e1="3" data-e2="5">
      <div class="lmn-timeline">
        <div class="lmn-tl-step">
          <div class="lmn-tl-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg></div>
          <span class="lmn-tl-title" data-f="hoy">Hoy pides</span>
          <small class="lmn-tl-sub">Pides sin pagar</small>
        </div>
        <div class="lmn-tl-line"></div>
        <div class="lmn-tl-step">
          <div class="lmn-tl-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg></div>
          <span class="lmn-tl-title" data-f="desp">1 - 2 días</span>
          <small class="lmn-tl-sub">Lo despachamos</small>
        </div>
        <div class="lmn-tl-line"></div>
        <div class="lmn-tl-step">
          <div class="lmn-tl-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg></div>
          <span class="lmn-tl-title" data-f="entr">3 - 5 días hábiles</span>
          <small class="lmn-tl-sub">Recibes y pagas</small>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- BARRA FIJA INFERIOR (aparece solo después de pasar el botón principal) -->
<div class="lmn-sticky-bottom-bar" id="lmnStickyBar">
  <div class="lmn-sticky-container">
    <div class="lmn-sticky-rating-header">
      <span><b>{{ M[0] }}</b> · Envío gratis · Pagas al recibir</span>
    </div>
    <button type="button" class="lmn-sticky-action-btn" id="lmnStickyTriggerBtn">
      <div class="lmn-sticky-btn-inner-border">
        <span class="lmn-sticky-btn-text">¡PEDIR Y PAGAR AL RECIBIR!</span>
      </div>
    </button>
  </div>
</div>

<style>
:root {
  --lmn-brand: #0E2A47;
  --lmn-brand-dark: #061626;
  --lmn-brand-light: #EAF0F6;
  --lmn-brand-rgb: 14, 42, 71;
  --lmn-price: #0E7490;
  --lmn-bg-soft: #F8F9FA;
  --lmn-text-dark: #0F172A;
  --lmn-text-gray: #475569;
  --lmn-success: #15803D;
}

/* BARRA DE ANUNCIOS SUPERIOR */
.lmn-announcement-bar, .lmn-announcement-bar * { box-sizing: border-box; }
.lmn-announcement-bar {
  width: 100%; max-width: 100%; margin: 0 0 6px 0;
  background: linear-gradient(90deg, var(--lmn-brand-dark) 0%, var(--lmn-brand) 50%, var(--lmn-brand-dark) 100%);
  color: #FFFFFF; font-family: 'Plus Jakarta Sans', sans-serif; font-size: 12.5px; font-weight: 600; letter-spacing: 0.2px;
  padding: 10px 0; overflow: hidden; position: relative;
  box-shadow: 0 6px 18px rgba(var(--lmn-brand-rgb), 0.16);
  border-top: 1px solid rgba(255, 255, 255, 0.12); border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}
.lmn-announcement-track { display: flex; width: max-content; animation: lmn-marquee 28s linear infinite; }
.lmn-announcement-bar:hover .lmn-announcement-track { animation-play-state: paused; }
.lmn-announcement-group { display: flex; align-items: center; white-space: nowrap; }
.lmn-announcement-group span { display: inline-flex; align-items: center; gap: 5px; padding: 0 14px; }
.lmn-announcement-group strong { color: #FDE68A; font-weight: 800; }
.lmn-ann-sep { color: rgba(255, 255, 255, 0.35); padding: 0 2px !important; }
@keyframes lmn-marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

