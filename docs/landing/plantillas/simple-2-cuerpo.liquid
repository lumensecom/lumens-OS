<script>
(function(){
  var root = document.getElementById('lmLanding');
  if(!root) return;

  // 0. Videos: se cargan y reproducen solo cuando aparecen en pantalla.
  var vids = root.querySelectorAll('video[data-src]');
  function cargar(v){ if(!v.src){ v.src = v.getAttribute('data-src') + '#t=0.1'; v.load(); } }
  function play(v){ cargar(v); var p = v.play(); if(p && p.catch) p.catch(function(){}); }
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){ if(en.isIntersecting){ play(en.target); } else if(en.target.src){ en.target.pause(); } });
    }, { rootMargin: '200px 0px', threshold: 0.15 });
    vids.forEach(function(v){ io.observe(v); });
  } else { vids.forEach(play); }

  // 0B. Antes / después
  var ba = document.getElementById('lmBA');
  if(ba){
    var rng = ba.querySelector('input'), dp = ba.querySelector('.dp'), bar = ba.querySelector('.bar'), knob = ba.querySelector('.knob');
    var mover = function(){ var v = rng.value; dp.style.clipPath = 'inset(0 0 0 ' + v + '%)'; bar.style.left = v + '%'; knob.style.left = v + '%'; };
    rng.addEventListener('input', mover); mover();
  }

  // 1. Packs de la landing (1, 2 o 3 camisillas). Por defecto se ve marcado el de 3 (lleva 3, paga 2).
  var selectedQty = '3';
  var plans = root.querySelectorAll('.lm-of');
  function syncShopifyQty(qty){
    document.querySelectorAll('input[name="quantity"]').forEach(function(inp){
      inp.value = qty;
      inp.dispatchEvent(new Event('change', { bubbles: true }));
    });
  }
  function selectPlan(el){
    plans.forEach(function(p){ p.classList.remove('on'); p.setAttribute('aria-pressed','false'); });
    el.classList.add('on'); el.setAttribute('aria-pressed','true');
    selectedQty = el.getAttribute('data-plan') || '2';
    syncShopifyQty(selectedQty);
  }
  plans.forEach(function(p){
    p.addEventListener('click', function(){ selectPlan(p); });
    p.addEventListener('keydown', function(e){ if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); selectPlan(p); } });
  });

  // 2. Releasit: marca la oferta de la misma posición (0 = 1 camisilla, 1 = 2, 2 = 3).
  function clickOferta(qty){
    var pos = String(parseInt(qty, 10) - 1);
    var todas = document.querySelectorAll('._rsi-quantity-offers-offer-container[data-offer-pos="' + pos + '"]');
    if(!todas.length) return false;
    var visibles = [].filter.call(todas, function(o){ return o.offsetParent !== null; });
    (visibles.length ? visibles : [].slice.call(todas)).forEach(function(o){ o.click(); });
    return true;
  }
  function marcarOferta(qty, n){
    n = n || 0;
    if(clickOferta(qty)){
      setTimeout(function(){ clickOferta(qty); }, 400);
      setTimeout(function(){ clickOferta(qty); }, 1000);
      return;
    }
    if(n < 50) setTimeout(function(){ marcarOferta(qty, n + 1); }, 100);
  }
  function botonReleasit(){
    return document.querySelector('#product-form-lmn ._rsi-buy-now-button-product, #product-form-lmn ._rsi-buy-now-button, #_rsi-buy-now-button, ._rsi-buy-now-button-product, ._rsi-buy-now-button');
  }

  // 3. Botones de la landing → abren el formulario de Releasit con el pack elegido
  root.querySelectorAll('.lm-cta[data-q="sel"]').forEach(function(btn){
    btn.addEventListener('click', function(){
      var qty = selectedQty;
      syncShopifyQty(qty);
      var intentos = 0;
      (function abrir(){
        var rsi = botonReleasit();
        if(rsi){
          clickOferta(qty);
          rsi.click();
          marcarOferta(qty, 0);
        } else if(intentos++ < 30){
          setTimeout(abrir, 100);
        } else {
          var packs = document.getElementById('lmPacks');
          if(packs) packs.scrollIntoView({ behavior: 'smooth' });
        }
      })();
    });
  });
})();
</script>
