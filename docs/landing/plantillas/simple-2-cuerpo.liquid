<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
.lm{--ac:#0E2A47;--dk:#061626;--hi:#1E9BF0;--soft:#EEF4FA;--line:#d5dde7;--ink:#121821;--mut:#5a6470;--ok:#16a34a;--price:#0E7490}
.lm,.lm *{box-sizing:border-box}
.lm{font-family:Manrope,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.5}
.lm img{max-width:100%;display:block}
.lm-w{max-width:760px;margin:0 auto;padding:0 18px}
.lm-sec{padding:36px 0}
.lm-sec.t{background:var(--soft)}
.lm-sec.o{background:var(--dk);color:#fff}
.lm-k{margin:0 0 6px;text-align:center;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--hi)}
.lm-h{margin:0 0 6px;text-align:center;font-size:25px;line-height:1.18;font-weight:800;letter-spacing:-.01em}
.lm-h em{font-style:normal;color:var(--hi)}
.lm-p{margin:0 auto 18px;max-width:480px;text-align:center;font-size:15px;color:var(--mut)}
.o .lm-p{color:#b9c6d4}
.lm-nota{margin:8px 0 0;text-align:center;font-size:11px;color:var(--mut)}
.o .lm-nota{color:#8fa1b4}
.lm-img{width:100%;height:auto;border-radius:18px}
.lm-cta{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;cursor:pointer;margin-top:20px;
 background:var(--ac);color:#fff;border-radius:999px;padding:17px 20px;font:800 16px/1.1 Manrope,sans-serif;letter-spacing:.02em;text-transform:uppercase;text-align:center;
 box-shadow:0 10px 24px rgba(14,42,71,.3);animation:lmPulse 2.8s infinite}
.lm-cta:active{transform:scale(.98)}
.o .lm-cta{background:var(--hi)}
.lm-cta svg{width:21px;height:21px;flex-shrink:0}
@keyframes lmPulse{0%,100%{box-shadow:0 10px 24px rgba(14,42,71,.3),0 0 0 0 rgba(30,155,240,.4)}60%{box-shadow:0 10px 24px rgba(14,42,71,.3),0 0 0 12px rgba(30,155,240,0)}}
@media (prefers-reduced-motion:reduce){.lm-cta{animation:none}}
.lm-sellos{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 14px;margin:12px 0 0;font-size:11.5px;font-weight:700}
.lm-sellos span::before{content:"✓ ";color:var(--ok)}
.o .lm-sellos span::before{color:var(--hi)}

/* 1 · VIDEOS */
.lm-vids{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.lm-vid{position:relative;margin:0;aspect-ratio:9/16;border-radius:18px;overflow:hidden;background:#0b1622;box-shadow:0 14px 30px -16px rgba(0,0,0,.6)}
.lm-vid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lm-vid figcaption{position:absolute;left:8px;right:8px;bottom:8px;padding:7px 8px;border-radius:10px;background:rgba(6,22,38,.72);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;font-size:12px;font-weight:800;text-align:center;line-height:1.2}

/* 2 · ANTES / DESPUÉS */
.lm-ba{position:relative;max-width:440px;margin:0 auto;aspect-ratio:2/3;border-radius:20px;overflow:hidden;background:#dfe6ee;user-select:none;-webkit-user-select:none;touch-action:pan-y;box-shadow:0 18px 40px -20px rgba(6,22,38,.5)}
.lm-ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
.lm-ba .dp{clip-path:inset(0 0 0 50%)}
.lm-ba .tag{position:absolute;top:12px;padding:5px 11px;border-radius:99px;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;z-index:2}
.lm-ba .ta{left:12px;background:rgba(255,255,255,.92);color:var(--ink)}
.lm-ba .td{right:12px;background:var(--hi);color:#fff}
.lm-ba .bar{position:absolute;top:0;bottom:0;left:50%;width:3px;margin-left:-1.5px;background:#fff;z-index:3;pointer-events:none}
.lm-ba .knob{position:absolute;top:50%;left:50%;width:46px;height:46px;margin:-23px 0 0 -23px;border-radius:50%;background:#fff;color:var(--ac);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;box-shadow:0 4px 14px rgba(0,0,0,.25);z-index:4;pointer-events:none}
.lm-ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;z-index:5;margin:0}

/* 3 · ¿TE PASA? */
.lm-dolor{list-style:none;margin:14px auto 0;padding:0;max-width:430px}
.lm-dolor li{display:flex;gap:10px;align-items:center;margin-bottom:8px;padding:12px 14px;background:#fff;border:1px solid var(--line);border-radius:12px;font-size:14.5px;font-weight:700}
.lm-dolor li::before{content:"✕";flex:0 0 22px;height:22px;border-radius:50%;background:#fde8e8;color:#d64545;font-size:12px;display:flex;align-items:center;justify-content:center}
.lm-giro{margin:14px auto 0;max-width:430px;padding:14px 16px;border-radius:14px;background:var(--ac);color:#fff;font-size:15px;font-weight:700;text-align:center}
.lm-giro b{color:#7cc8ff}

/* 4 · TIRA */
.lm-tira{overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.lm-pista{display:flex;gap:12px;width:max-content;animation:lmMove 48s linear infinite}
.lm-tira:active .lm-pista{animation-play-state:paused}
@keyframes lmMove{to{transform:translate3d(-50%,0,0)}}
@media (prefers-reduced-motion:reduce){.lm-pista{animation:none}}
.lm-foto{margin:0;flex:0 0 auto;width:210px;aspect-ratio:4/5;border-radius:18px;overflow:hidden;border:3px solid #fff;box-shadow:0 10px 22px -12px rgba(16,24,40,.45);background:#dfe6ee}
.lm-foto img{width:100%;height:100%;object-fit:cover}

/* 5 · BENEFICIOS */
.lm-bl{list-style:none;padding:0;margin:16px auto 0;max-width:430px}
.lm-bl li{display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;font-size:15px}
.lm-bl li::before{content:"✓";flex:0 0 24px;height:24px;border-radius:50%;background:var(--hi);color:#fff;font-size:13px;font-weight:800;display:flex;align-items:center;justify-content:center;margin-top:1px}
.lm-bl b{display:block}
.lm-bl span{color:var(--mut);font-size:13.5px}

/* 6 · PASOS */
.lm-pasos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.lm-paso{position:relative;margin:0;border-radius:16px;overflow:hidden;aspect-ratio:3/4;background:#dfe6ee}
.lm-paso img{width:100%;height:100%;object-fit:cover}
.lm-paso b{position:absolute;top:8px;left:8px;width:28px;height:28px;border-radius:50%;background:var(--hi);color:#fff;display:flex;align-items:center;justify-content:center;font-size:14px;box-shadow:0 0 0 3px #fff}
.lm-paso figcaption{position:absolute;left:0;right:0;bottom:0;padding:24px 6px 9px;background:linear-gradient(transparent,rgba(6,22,38,.9));color:#fff;font-size:12px;font-weight:800;text-align:center;line-height:1.2}

/* 7 · REGALO */
.lm-regalo{position:relative;border-radius:20px;overflow:hidden;min-height:330px;display:flex;align-items:flex-end;background:var(--ink);color:#fff}
.lm-regalo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lm-regalo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(6,22,38,.92) 80%)}
.lm-regalo div{position:relative;z-index:1;padding:20px}
.lm-regalo small{display:inline-block;background:#f5c518;color:#111;font-size:11px;font-weight:800;padding:5px 12px;border-radius:99px;margin-bottom:8px}
.lm-regalo b{display:block;font-size:20px;line-height:1.2;margin-bottom:4px}
.lm-regalo p{margin:0;color:#dbe3ec;font-size:14px}

/* 8 · PACKS */
#lmLanding .lm-planes{display:grid;gap:10px;margin:18px 0 0}
#lmLanding .lm-of{position:relative;display:flex;align-items:center;gap:12px;padding:15px 14px;background:#fff;border:1.5px dashed var(--line);border-radius:14px;cursor:pointer;transition:border-color .2s,box-shadow .2s}
#lmLanding .lm-of.on{border:2px solid var(--ac);box-shadow:0 6px 18px -6px rgba(14,42,71,.25)}
#lmLanding .lm-of .rd{width:20px;height:20px;border:2px solid #c3cad4;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center}
#lmLanding .lm-of.on .rd{border-color:var(--ac)}#lmLanding .lm-of.on .rd::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--ac)}
#lmLanding .lm-of .qn{flex:1;min-width:0}#lmLanding .lm-of .qn b{display:block;font-size:16px}#lmLanding .lm-of .qn small{font-size:12px;color:var(--mut)}
#lmLanding .lm-of .cu{text-align:right}#lmLanding .lm-of .cu b{display:block;font-size:19px;font-weight:800;color:var(--price)}#lmLanding .lm-of .cu s{font-size:12px;color:#9aa3ad}
#lmLanding .lm-of .tag{position:absolute;top:-11px;right:14px;background:#111827;color:#fff;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:6px}
#lmLanding .lm-of .tag.best{background:#16a34a}
#lmLanding .lm-of.star{padding:17px 14px;border:2px solid var(--hi);background:linear-gradient(135deg,#f0f8ff,#fff 60%);margin-bottom:6px}
#lmLanding .lm-of.star.on{box-shadow:0 10px 26px -10px rgba(30,155,240,.55)}
#lmLanding .lm-of.star .qn b{font-size:18px;color:var(--ac)}
#lmLanding .lm-of.star .cu b{font-size:22px}
#lmLanding .lm-of .free{display:inline-block;margin-top:4px;padding:3px 8px;border-radius:99px;background:#dcfce7;color:#15803d;font-size:11px;font-weight:800}
#lmLanding .lm-of.top{margin-top:8px}
.lm-gt{display:flex;gap:12px;align-items:center;margin-top:16px;padding:14px 16px;border-radius:14px;background:#fff;border:1.5px solid var(--line)}
.lm-gt i{font-style:normal;flex:0 0 54px;height:54px;border-radius:50%;background:var(--ac);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;font-size:8px;font-weight:800;letter-spacing:.08em}
.lm-gt i strong{font-size:19px}
.lm-gt p{margin:0;font-size:13.5px;color:var(--mut)}.lm-gt p b{color:var(--ink)}

/* 9 · DUDAS */
.lm-faq details{border-bottom:1px solid var(--line)}
.lm-faq summary{list-style:none;display:flex;justify-content:space-between;gap:12px;padding:15px 0;font-size:16px;font-weight:800;line-height:1.3;cursor:pointer}
.lm-faq summary::-webkit-details-marker{display:none}
.lm-faq summary::after{content:"+";color:var(--hi);font-size:26px;font-weight:700;line-height:.9}
.lm-faq details[open] summary::after{content:"−"}
.lm-faq p{margin:0 0 16px;font-size:14px;color:var(--mut)}
.lm-wa{display:flex;align-items:center;justify-content:center;gap:8px;margin:20px auto 0;max-width:300px;background:#25D366;color:#fff!important;text-decoration:none;font-size:14px;font-weight:800;padding:12px 16px;border-radius:99px}
.lm-wa svg{width:18px;height:18px}
.lm-legal{margin:18px 0 0;font-size:11.5px;color:var(--mut);line-height:1.55}

/* 10 · CIERRE */
.lm-cierre-img{width:100%;max-width:400px;aspect-ratio:3/4;object-fit:cover;margin:0 auto 20px;border-radius:20px;box-shadow:0 18px 40px -20px rgba(0,0,0,.6)}
.lm-pie{background:var(--dk);color:#fff;padding:30px 0 96px;width:100vw;position:relative;left:50%;margin-left:-50vw;text-align:center}
.lm-pie nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;padding-bottom:16px;border-bottom:1px solid rgba(255,255,255,.15)}
.lm-pie a{color:rgba(255,255,255,.85);text-decoration:none;font-size:13px}
.lm-pie p{margin:14px 0 0;font-size:12px;color:rgba(255,255,255,.6)}
.lm-pie strong{display:block;margin-top:14px;font-size:22px;letter-spacing:-.03em}
@media(min-width:768px){.lm-h{font-size:31px}.lm-sec{padding:52px 0}.lm-vids{max-width:560px;margin:0 auto}.lm-foto{width:250px}.lm-pasos{gap:14px}.lm-paso figcaption{font-size:14px}}
</style>

<div class="lm" id="lmLanding">

  <!-- ═══ 1 · VIDEOS: MÍRALA PUESTA ═══ -->
  <section class="lm-sec o">
    <div class="lm-w">
      <p class="lm-k">Míralo tú mismo</p>
      <h2 class="lm-h">Te la pones y <em>la camiseta cae lisa</em></h2>
      <p class="lm-p">Sin trucos de cámara: así se ve puesta.</p>
      <div class="lm-vids">
        {%- if vid_1 != '' -%}<figure class="lm-vid"><video muted loop playsinline preload="none" data-src="{{ vid_1 }}" aria-label="Hombre abre la caja y se pone la camisilla Ionfit Pro"></video><figcaption>Llega, la abres y te la pones</figcaption></figure>{%- endif -%}
        {%- if vid_2 != '' -%}<figure class="lm-vid"><video muted loop playsinline preload="none" data-src="{{ vid_2 }}" aria-label="Hombre entrenando con la camisilla Ionfit Pro"></video><figcaption>Sola en el gym</figcaption></figure>{%- endif -%}
      </div>
    </div>
  </section>

  <!-- ═══ 2 · ANTES / DESPUÉS ═══ -->
  {%- if img_antes != '' and img_despues != '' -%}
  <section class="lm-sec">
    <div class="lm-w">
      <p class="lm-k">Desliza y compara</p>
      <h2 class="lm-h">Mismo hombre, <em>misma luz</em></h2>
      <p class="lm-p">Arrastra la línea de un lado a otro.</p>
      <div class="lm-ba" id="lmBA">
        <img src="{{ img_antes }}" alt="Sin la camisilla Ionfit Pro" loading="lazy" width="1200" height="1800">
        <img class="dp" src="{{ img_despues }}" alt="Con la camisilla Ionfit Pro puesta" loading="lazy" width="1200" height="1800">
        <span class="tag ta">Sin Ionfit</span><span class="tag td">Con Ionfit</span>
        <span class="bar"></span><span class="knob">↔</span>
        <input type="range" min="0" max="100" value="50" aria-label="Comparar sin y con la camisilla">
      </div>
      <p class="lm-nota">Imagen ilustrativa · efecto visual mientras la usas.</p>
    </div>
  </section>
  {%- endif -%}

  <!-- ═══ 3 · ¿TE PASA? ═══ -->
  <section class="lm-sec t">
    <div class="lm-w">
      <p class="lm-k">¿Te pasa?</p>
      <h2 class="lm-h">Tu camiseta no debería marcar <em>lo que no quieres</em></h2>
      <ul class="lm-dolor">
        <li>La camiseta se pega y se marca en el abdomen</li>
        <li>Te cambias de ropa antes de salir</li>
        <li>Prefieres tomar la foto que salir en ella</li>
      </ul>
      <p class="lm-giro">Con Ionfit Pro debajo, <b>te vistes una vez y sales.</b></p>
      <button type="button" class="lm-cta" data-q="sel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6"/></svg><span>Quiero mi Ionfit</span></button>
      <div class="lm-sellos"><span>Pagas al recibir</span><span>Envío gratis</span><span>Cambio de talla</span></div>
    </div>
  </section>

  <!-- ═══ 4 · NADIE LO NOTA (TIRA) ═══ -->
  <section class="lm-sec" style="overflow:hidden">
    <div class="lm-w">
      <p class="lm-k">En la cena, en la boda, en la foto</p>
      <h2 class="lm-h">Nadie nota que la llevas. <em>Solo que te ves mejor.</em></h2>
      <p class="lm-p">Va debajo de la camisa, la polo o la camiseta.</p>
    </div>
    <div class="lm-tira" aria-label="Hombres usando la camisilla debajo de la ropa">
      <div class="lm-pista">
        {%- for i in (1..2) -%}
          {%- for u in casa -%}
            {%- assign u = u | strip -%}
            {%- if u != '' -%}<figure class="lm-foto"{% if i == 2 %} aria-hidden="true"{% endif %}><img src="{{ u }}" alt="Hombre con la camisilla debajo de la ropa" loading="lazy" width="420" height="525"></figure>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <p class="lm-nota">Imágenes ilustrativas.</p>
  </section>

  <!-- ═══ 5 · BENEFICIOS ═══ -->
  <section class="lm-sec o">
    <div class="lm-w">
      <p class="lm-k">Por qué funciona</p>
      <h2 class="lm-h">Compresión justo <em>donde se nota</em></h2>
      {%- if img_info != '' -%}<img class="lm-img" src="{{ img_info }}" alt="Beneficios de la camisilla Ionfit Pro" loading="lazy" width="1000" height="1000" style="margin-top:16px">{%- endif -%}
      <ul class="lm-bl">
        <li><div><b>Torso más definido</b><span>El panel frontal ajusta el abdomen y la ropa cae lisa.</span></div></li>
        <li><div><b>Pecho y espalda firmes</b><span>Te ayuda a mantenerte derecho todo el día.</span></div></li>
        <li><div><b>Ligera y fresca</b><span>Tela elástica que respira, del gym a la oficina.</span></div></li>
      </ul>
      {%- if img_detalle != '' -%}<img class="lm-img" src="{{ img_detalle }}" alt="Detalles de la camisilla: panel de compresión, costados y escote en V" loading="lazy" width="1000" height="1000" style="margin-top:10px">{%- endif -%}
      <button type="button" class="lm-cta" data-q="sel"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2 3h3l2.6 12.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1L21 8H6"/></svg><span>Pedir y pagar al recibir</span></button>
      <p class="lm-nota">Efecto visual mientras la usas. No reemplaza el ejercicio ni la alimentación.</p>
    </div>
  </section>

  <!-- ═══ 6 · ASÍ DE FÁCIL ═══ -->
  <section class="lm-sec">
