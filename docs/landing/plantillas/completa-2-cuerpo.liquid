                <h4>“{{ c[3] | strip | escape }}”</h4>
                <p>{{ c[4] | strip | escape }}</p>
                <small>{{ c[0] | strip | escape }} · {{ c[1] | strip | escape }} <span class="lm-ver"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>Compra verificada</span></small>
              </div>
