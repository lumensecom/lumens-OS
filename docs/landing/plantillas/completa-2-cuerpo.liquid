<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
<style>
.lm{--ac:#0E2A47;--ac-dk:#061626;--ac-rgb:14,42,71;--soft:#EAF0F6;--line:#cfd6e0;--card:#f7f8fa;--ink:#141a22;--muted:#56606c;--star:#e0a32b;--ok:#2d9e5c;--price:#0E7490}
.lm,.lm *{box-sizing:border-box}
.lm{font-family:Manrope,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);-webkit-font-smoothing:antialiased;line-height:1.5}
.lm img{max-width:100%}
.lm-w{max-width:860px;margin:0 auto;padding:0 18px}
.lm-sec{padding:38px 0}
.lm-sec.tinte{background:var(--soft)}
.lm-sec.oscuro{background:var(--ac-dk);color:#fff}
.lm-ac{color:var(--ac);font-style:normal}
.oscuro .lm-ac{color:#7dd3fc}
.lm-ante{margin:0 0 8px;text-align:center;font-size:11px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--ac-dk)}
.oscuro .lm-ante{color:#9fb3c8}
.lm-h2{margin:0 0 6px;text-align:center;font-size:24px;line-height:1.2;font-weight:800;letter-spacing:-.01em}
.lm-sub{margin:0 auto 20px;max-width:520px;text-align:center;font-size:15px;color:var(--muted)}
.oscuro .lm-sub{color:#c3cfdb}
.lm-cta{all:unset;box-sizing:border-box;display:flex;align-items:center;justify-content:center;gap:10px;width:100%;cursor:pointer;
 background:var(--ac);color:#fff;border-radius:999px;padding:17px 20px;font:800 16px/1.1 Manrope,sans-serif;letter-spacing:.02em;text-transform:uppercase;
 box-shadow:0 10px 24px rgba(var(--ac-rgb),.32);animation:lmLate 2.8s infinite;transition:transform .12s,background .2s;text-align:center;margin-top:20px}
.lm-cta:hover{background:var(--ac-dk)}.lm-cta:active{transform:scale(.98)}
.oscuro .lm-cta{background:#fff;color:var(--ac-dk)}
.lm-cta svg{width:21px;height:21px;flex-shrink:0}
@keyframes lmLate{0%,100%{box-shadow:0 10px 24px rgba(var(--ac-rgb),.32),0 0 0 0 rgba(var(--ac-rgb),.35)}60%{box-shadow:0 10px 24px rgba(var(--ac-rgb),.32),0 0 0 12px rgba(var(--ac-rgb),0)}}
@media (prefers-reduced-motion:reduce){.lm-cta{animation:none}}
.lm-sellos{display:flex;justify-content:center;flex-wrap:wrap;gap:6px 14px;margin:12px 0 0;font-size:11.5px;font-weight:700}
.lm-sellos span{display:inline-flex;align-items:center;gap:5px}.lm-sellos svg{width:15px;height:15px;color:var(--ac)}
.lm-card{background:var(--card);border:1px solid var(--line);border-radius:16px;box-shadow:0 1px 2px rgba(16,24,40,.04),0 6px 16px -8px rgba(16,24,40,.12)}
.lm-est{color:var(--star);letter-spacing:1px}.lm-est i{color:#d9d4dc;font-style:normal}
.lm-ver{display:inline-flex;align-items:center;gap:4px;background:#e7f6ee;color:var(--ok);font-size:10.5px;font-weight:800;padding:3px 8px;border-radius:99px}
.lm-ver svg{width:11px;height:11px}
@keyframes lmMover{to{transform:translate3d(-50%,0,0)}}
.lm-img{display:block;width:100%;height:auto;border-radius:18px;margin:18px 0 0}
.lm-aviso{margin:8px 0 0;text-align:center;font-size:11px;color:var(--muted)}
.oscuro .lm-aviso{color:#9fb3c8}
/* Video */
.lm-vid{position:relative;margin:0 auto;width:100%;max-width:330px;aspect-ratio:9/16;border-radius:20px;overflow:hidden;background:#0b1622;box-shadow:0 18px 40px -18px rgba(6,22,38,.55)}
.lm-vid video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.lm-vid figcaption{position:absolute;left:10px;right:10px;bottom:10px;padding:8px 10px;border-radius:12px;background:rgba(6,22,38,.72);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);color:#fff;font-size:12.5px;font-weight:800;line-height:1.25;text-align:center}
.lm-vid .pl{position:absolute;top:10px;left:10px;display:inline-flex;align-items:center;gap:5px;background:#fff;color:var(--ac-dk);font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 9px;border-radius:99px}
.lm-vid .pl::before{content:"";width:6px;height:6px;border-radius:50%;background:#e23b3b}
@media(min-width:768px){.lm-h2{font-size:30px}.lm-sec{padding:54px 0}}

/* 1 · CONFIANZA + TIRA */
.lm-social{padding:28px 0 32px;background:var(--soft);overflow:hidden}
.lm-confia{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;margin:0 0 26px}
.lm-confia div{display:flex;align-items:center;gap:9px;background:#fff;border:1px solid var(--line);border-radius:12px;padding:10px 11px;font-size:12.5px;font-weight:700;line-height:1.25}
.lm-confia svg{width:22px;height:22px;color:var(--ac);flex-shrink:0}
.lm-tira{width:100%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent);mask-image:linear-gradient(90deg,transparent,#000 4%,#000 96%,transparent)}
.lm-pista{display:flex;gap:12px;width:max-content;animation:lmMover 45s linear infinite}
.lm-tira:hover .lm-pista,.lm-tira:active .lm-pista{animation-play-state:paused}
@media (prefers-reduced-motion:reduce){.lm-pista{animation:none}}
.lm-foto{margin:0;flex:0 0 auto;width:220px;aspect-ratio:4/5;border-radius:18px;overflow:hidden;background:#dde5f0;box-shadow:0 10px 22px -12px rgba(16,24,40,.45);border:3px solid #fff}
.lm-foto img{width:100%;height:100%;object-fit:cover;display:block}
.lm-resbar{display:flex;align-items:center;justify-content:center;gap:8px;margin:22px 0 12px;font-size:14px;color:var(--muted)}
.lm-resbar b{font-size:20px;color:var(--ink)}
.lm-revs{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 18px 10px;scrollbar-width:none}.lm-revs::-webkit-scrollbar{display:none}
.lm-rev{flex:0 0 80%;max-width:330px;scroll-snap-align:center;overflow:hidden;background:#fff;border:1px solid var(--line);border-radius:16px}
.lm-rev img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.lm-rev div{padding:14px 16px 16px}.lm-rev h4{margin:6px 0 6px;font-size:15px;line-height:1.3;color:var(--ac-dk)}
.lm-rev p{margin:0 0 10px;font-size:13.5px;color:var(--muted)}
.lm-rev small{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:12.5px;font-weight:800}

/* 2 · ¿TE PASA? */
.lm-pas ul{list-style:none;margin:16px auto 22px;padding:0;max-width:440px}
.lm-pas li{display:flex;gap:10px;align-items:center;margin-bottom:8px;padding:11px 14px;background:#fff;border:1px solid var(--line);border-radius:12px;font-size:14.5px;font-weight:700}
.lm-pas li svg{width:18px;height:18px;color:#d64545;flex-shrink:0}
.lm-flecha{margin:0 0 14px;text-align:center;font-size:13px;font-weight:800;color:var(--ac)}

/* Cinta */
.lm-chips{overflow:hidden;background:var(--ac-dk);padding:11px 0}
.lm-chips .t{display:flex;width:max-content;animation:lmMover 34s linear infinite}
.lm-chips span{display:inline-flex;align-items:center;gap:6px;padding:0 14px;font-size:12.5px;font-weight:700;color:#e6edf5;white-space:nowrap}
.lm-chips svg{width:14px;height:14px;color:#7dd3fc}

/* 3 · MÍRALO EN ACCIÓN */
.lm-vids{display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 18px 12px;margin:0 -18px;scrollbar-width:none}
.lm-vids::-webkit-scrollbar{display:none}
.lm-vids .lm-vid{flex:0 0 64%;max-width:260px;scroll-snap-align:center;margin:0}
.lm-desliza{margin:2px 0 0;text-align:center;font-size:11.5px;font-weight:700;color:var(--muted)}

/* 4 · BENEFICIOS */
.lm-bgrid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin-top:18px}
.lm-b{padding:16px 12px;text-align:center;background:#fff}
.lm-b i{font-style:normal;display:flex;align-items:center;justify-content:center;width:54px;height:54px;margin:0 auto 8px;border-radius:16px;background:var(--soft);font-size:27px}
.lm-b b{display:block;font-size:14.5px;line-height:1.25;margin-bottom:3px}
.lm-b p{margin:0;font-size:12.5px;color:var(--muted);line-height:1.4}

/* 5 · CÓMO FUNCIONA */
.lm-zonas{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:18px}
.lm-zona{padding:14px 8px;text-align:center;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.16);border-radius:16px}
.lm-zona .n{width:34px;height:34px;margin:0 auto;border-radius:50%;background:#7dd3fc;color:var(--ac-dk);font-weight:800;display:flex;align-items:center;justify-content:center}
.lm-zona b{display:block;font-size:14px;margin:8px 0 2px;color:#fff}
.lm-zona p{margin:0;font-size:11.5px;color:#c3cfdb;line-height:1.35}

/* 6 · ASÍ SE USA */
.lm-pasos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin-top:18px}
.lm-paso{position:relative;margin:0;border-radius:16px;overflow:hidden;background:#dde5f0;aspect-ratio:3/4;box-shadow:0 10px 22px -14px rgba(16,24,40,.5)}
.lm-paso img{width:100%;height:100%;object-fit:cover;display:block}
.lm-paso b{position:absolute;top:8px;left:8px;width:28px;height:28px;border-radius:50%;background:var(--ac);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:14px;box-shadow:0 0 0 3px #fff}
.lm-paso figcaption{position:absolute;left:0;right:0;bottom:0;padding:22px 8px 9px;background:linear-gradient(transparent,rgba(6,22,38,.88));color:#fff;font-size:12px;font-weight:800;line-height:1.25;text-align:center}

/* 7 · COMPARATIVA */
.lm-vs{display:grid;grid-template-columns:1.25fr 1fr 1fr;border:1px solid var(--line);border-radius:18px;overflow:hidden;background:#fff;margin-top:18px}
.lm-vs>div{padding:12px 10px;border-top:1px solid var(--line);font-size:13px;display:flex;align-items:center}
.lm-vs .hd{border-top:0;font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);justify-content:center;text-align:center;background:var(--soft)}
.lm-vs .hd.nos{background:var(--ac);color:#fff}
.lm-vs .f{font-weight:700}
.lm-vs .s,.lm-vs .x{justify-content:center}
.lm-vs .s.nos{background:#f2f7fc}
.lm-vs svg{width:22px;height:22px}
.lm-vs .s svg{color:var(--ok)}.lm-vs .x svg{color:#c43c3c}

/* 8 · GARANTÍA */
.lm-gt{text-align:center;padding:28px 20px;background:#fff}
.lm-gt-sello{position:relative;width:108px;height:108px;margin:0 auto 14px;border-radius:50%;background:var(--ac);color:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;line-height:1;box-shadow:0 8px 18px rgba(var(--ac-rgb),.3)}
.lm-gt-sello::before{content:"";position:absolute;inset:6px;border:1.5px dashed rgba(255,255,255,.6);border-radius:50%}
.lm-gt-sello small{font-size:9px;font-weight:800;letter-spacing:.14em}.lm-gt-sello b{font-size:35px;font-weight:800;margin:2px 0}
.lm-gt h3{margin:0 0 8px;font-size:21px;line-height:1.25}.lm-gt>p{margin:0 auto 14px;max-width:440px;font-size:14.5px;color:var(--muted)}
.lm-gt ul{list-style:none;padding:0;margin:0 auto;max-width:360px;text-align:left}
.lm-gt li{display:flex;gap:8px;align-items:center;font-size:13.5px;font-weight:700;margin-bottom:7px}.lm-gt li svg{width:17px;height:17px;color:var(--ok);flex-shrink:0}

/* 9 · REGALO */
.lm-regalo{position:relative;border-radius:20px;overflow:hidden;min-height:340px;display:flex;align-items:flex-end;background:var(--ink);color:#fff}
.lm-regalo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.lm-regalo::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(6,22,38,0) 25%,rgba(6,22,38,.92) 78%)}
.lm-regalo div{position:relative;z-index:1;padding:22px 20px}
.lm-regalo small{display:inline-block;background:var(--star);color:#111;font-size:11px;font-weight:800;padding:5px 12px;border-radius:99px;margin-bottom:10px}
.lm-regalo b{display:block;font-size:21px;line-height:1.2;margin-bottom:6px}.lm-regalo p{margin:0;color:#dbe3ec;font-size:14px}

/* 10 · PACKS */
#lmLanding .lm-planes{display:grid;gap:10px;margin:18px 0 0}
#lmLanding .lm-of{position:relative;display:flex;align-items:center;gap:12px;padding:15px 14px;background:#fff;border:1.5px dashed var(--line);border-radius:14px;cursor:pointer;transition:border-color .2s,background .2s,box-shadow .2s}
#lmLanding .lm-of.on{border:2px solid var(--ac);box-shadow:0 6px 18px -6px rgba(var(--ac-rgb),.24)}
#lmLanding .lm-of .rd{width:20px;height:20px;border:2px solid #c3cad4;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center}
#lmLanding .lm-of.on .rd{border-color:var(--ac)}#lmLanding .lm-of.on .rd::after{content:"";width:10px;height:10px;border-radius:50%;background:var(--ac)}
#lmLanding .lm-of .qn{flex:1;min-width:0}#lmLanding .lm-of .qn b{display:block;font-size:16px}#lmLanding .lm-of .qn small{font-size:12px;color:var(--muted)}
#lmLanding .lm-of .cu{text-align:right}#lmLanding .lm-of .cu b{display:block;font-size:19px;font-weight:800;color:var(--price)}#lmLanding .lm-of .cu s{font-size:12px;color:#9aa3ad}
#lmLanding .lm-of .tag{position:absolute;top:-11px;right:14px;background:#111827;color:#fff;font-size:10px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;padding:4px 10px;border-radius:6px}
#lmLanding .lm-of .tag.best{background:#B7791F}
#lmLanding .lm-of.top{margin-top:8px}

/* 11 · FICHA Y DUDAS */
.lm-det{border-top:1px solid var(--line)}
.lm-det details{border-bottom:1px solid var(--line)}
.lm-det summary{list-style:none;display:flex;align-items:center;gap:10px;padding:16px 2px;font-size:15px;font-weight:800;cursor:pointer}
.lm-det summary::-webkit-details-marker{display:none}
.lm-det summary svg{width:20px;height:20px;color:var(--ac);flex-shrink:0}
.lm-det summary::after{content:"";margin-left:auto;width:8px;height:8px;border-right:2px solid var(--muted);border-bottom:2px solid var(--muted);transform:rotate(45deg);transition:transform .2s}
.lm-det details[open] summary::after{transform:rotate(-135deg)}
.lm-det .cu{padding:0 2px 16px 30px;font-size:14px;color:var(--muted);white-space:pre-line}
.lm-faq details{border-bottom:1px solid var(--line)}
.lm-faq summary{list-style:none;display:flex;justify-content:space-between;gap:12px;padding:15px 0;font-size:16px;font-weight:800;line-height:1.3;cursor:pointer}
.lm-faq summary::-webkit-details-marker{display:none}
.lm-faq summary::after{content:"+";color:var(--ac);font-size:26px;font-weight:700;line-height:.9}
.lm-faq details[open] summary::after{content:"−"}
.lm-faq p{margin:0 0 16px;font-size:14px;color:var(--muted)}
.lm-ayuda{margin:20px 0 0;padding:16px;text-align:center;border-radius:14px;background:var(--soft);font-size:14px}
.lm-ayuda a{display:inline-flex;align-items:center;gap:7px;margin-top:8px;background:#25D366;color:#fff!important;text-decoration:none;font-size:13px;font-weight:800;padding:10px 16px;border-radius:99px}
.lm-ayuda a svg{width:16px;height:16px}
.lm-legal{margin:18px 0 0;font-size:11.5px;color:var(--muted);line-height:1.55}

/* 12 · CIERRE */
.lm-cierre{text-align:center}
.lm-cierre-img{display:block;width:100%;max-width:420px;aspect-ratio:4/5;object-fit:cover;margin:0 auto 20px;border-radius:20px;box-shadow:0 18px 40px -20px rgba(6,22,38,.55)}
.lm-pie{background:var(--ac-dk);color:#fff;padding:36px 0 96px;width:100vw;position:relative;left:50%;margin-left:-50vw}
.lm-pie-nav{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 22px;padding:18px 0;border-top:1px solid rgba(255,255,255,.15);border-bottom:1px solid rgba(255,255,255,.15)}
.lm-pie-nav a{color:rgba(255,255,255,.85);text-decoration:none;font-size:13px}
.lm-pie-bot{display:flex;flex-direction:column;align-items:center;gap:10px;padding-top:18px;font-size:12px;color:rgba(255,255,255,.65);text-align:center}
.lm-pie-bot strong{font-size:22px;letter-spacing:-.03em;color:#fff}
.lm-pie-pagos{display:flex;gap:6px;flex-wrap:wrap;justify-content:center}.lm-pie-pagos span{font-size:10px;font-weight:800;color:#fff;border:1px solid rgba(255,255,255,.25);padding:4px 8px;border-radius:6px}
@media(max-width:520px){.lm-vs{grid-template-columns:1.4fr .8fr .8fr}.lm-vs>div{font-size:12.5px;padding:11px 8px}}
